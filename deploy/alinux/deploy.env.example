# ============================================================================
# deploy.env —— 部署时指向哪台机器。这份被 .gitignore 挡住，只在本机存在。
# 格式：一行一个 KEY=VALUE，deploy.sh 会在读环境变量之后 source 它（set -a，所以都会导出）。
#
# 本机怎么落地：cp deploy.env.example deploy.env，把地址改成你自己的。
# 只放地址这类"泄露了也不致命"的值。SSH 口令不放这里——它从钥匙串现取：
#   ALINUX_SSH_PASS="$(security find-generic-password -s emotion-alinux-prod-ssh -a root -w)" \
#     bash deploy/alinux/deploy.sh
# ============================================================================

# 服务器公网 IP（deploy.sh 里所有远端命令、健康检查都用它）
ALINUX_HOST=

# ④ 步渲染给生产那份配置（config/application-local.yml.template）里的库地址。
# 注意这两个是「**服务器上**那个后端进程去连谁」，跟本机联调连哪个库无关
#（本机走环境变量 ${MYSQL_IP:localhost}）。缺省 localhost / 3306，即库在同一台机器上。
EMOTION_DB_HOST=localhost
EMOTION_DB_PORT=3306

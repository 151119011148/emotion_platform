            <tr><td>002453</td><td>华软科技</td><td class="ctr">2</td><td>化学制品</td><td class="ctr num" style="color:#b91c1c">+9.93%</td><td class="ctr"><span class="b b-red">晋级 3 板</span></td></tr>
            <tr><td>600127</td><td>金健米业</td><td class="ctr">2</td><td>农产品加工</td><td class="ctr num" style="color:#b91c1c">+9.99%</td><td class="ctr"><span class="b b-red">晋级 3 板</span></td></tr>

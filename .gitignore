# 构建产物与依赖
target/
out/
node_modules/
dist/
# 部署产物（scripts/deploy/build.sh 归集出来的一坨，只在本地/CI 上临时存在）
dist-deploy/

# 本地凭据。application.yml 里只有 ${MYSQL_PASSWORD:} / ${JWT_SECRET:} 两个占位，
# 真值在这一份；文件名不带路径，将来换目录也不漏。填法见 application-local.yml.example。
application-local.yml

# IDE
.idea/
*.iml

# 系统垃圾
.DS_Store
*.log
# 滚动出来的 .log.gz 躲得过 *.log，直接把 logback 的输出目录整个排掉
logs/

# 整份内容是把 root 口令写死再 sed 进 application.yml；它自己的存在就是泄露。
mysql-reinstall.sh

# 放手记的目录，不是代码。
复盘/

# 临时/补丁脚本
*.py
# 例外：可复用的数据库导出脚本需要入库
!scripts/
!scripts/**
